---
import { GIMNASIO, DATOS, PLANES, PRECIO_MES, WHATSAPP, pesos } from '../data/atenas.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (ruta) => `${base}/${ruta}`;
// Los mensajes llevan la marca de la maqueta para que José David sepa de dónde vienen.
const wa = (texto) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(`${texto} (Lo escribo desde la maqueta de Atenas Gym)`)}`;

const GRUPOS = [
  { id: 'corto', titulo: 'Corto plazo' },
  { id: 'mes', titulo: 'Mensual' },
  { id: 'largo', titulo: 'Largo plazo' },
];
const ahorro = (p) => (p.meses > 1 ? PRECIO_MES * p.meses - p.precio : 0);

const HORARIO = [
  { dias: 'Lunes a viernes', horas: '5:00 a. m. – 11:00 p. m.', data: '1,2,3,4,5' },
  { dias: 'Sábados', horas: '8:00 a. m. – 3:00 p. m.', data: '6' },
  { dias: 'Domingos', horas: '9:00 a. m. – 2:00 p. m.', data: '0' },
  { dias: 'Festivos', horas: '9:00 a. m. – 2:00 p. m.', data: '' },
];

const FOTOS = [
  ['gym-fila.webp', 'Máquinas', 'alta'],
  ['jalon-pecho.webp', 'Poleas', ''],
  ['caminadoras.webp', 'Cardio', ''],
  ['banco.webp', 'Peso libre', ''],
  ['bicis-rojas.webp', 'Bicicletas', 'alta'],
  ['prensa-piernas.webp', 'Pierna', ''],
];

// QR de muestra (no se puede escanear): cuadrícula de 21×21 con las tres esquinas de un QR y relleno fijo.
const QR = 21;
const esquina = (x, y) => {
  for (const [cx, cy] of [[0, 0], [QR - 7, 0], [0, QR - 7]]) {
    const dx = x - cx, dy = y - cy;
    if (dx >= 0 && dx < 7 && dy >= 0 && dy < 7) return { dentro: true, lleno: dx === 0 || dx === 6 || dy === 0 || dy === 6 || (dx > 1 && dx < 5 && dy > 1 && dy < 5) };
  }
  return { dentro: false };
};
const celdas = [];
for (let y = 0; y < QR; y++) for (let x = 0; x < QR; x++) {
  const e = esquina(x, y);
  if (e.dentro ? e.lleno : ((x * 73856093) ^ (y * 19349663) ^ (x * y * 83492791)) % 5 < 2) celdas.push([x, y]);
}

const PANEL = [
  { valor: '312', texto: 'Socios activos' },
  { valor: '14', texto: 'Vencen esta semana' },
  { valor: '$1.248.000', texto: 'Ingresos de hoy' },
  { valor: '9', texto: 'Sin venir hace 14 días' },
];

const mapa = 'https://www.google.com/maps?q=' + encodeURIComponent(`Atenas Gym, ${GIMNASIO.direccion}`);
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Atenas Gym · Chapinero, Cali (maqueta de propuesta)</title>
  <meta name="description" content="Maqueta de propuesta de página web para Atenas Gym (Chapinero, Cali), hecha por José David Rodríguez. No es la página oficial del gimnasio.">
  <!-- Maqueta para mostrarle al gimnasio: no debe aparecer en Google como si fuera su página oficial. -->
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#141210">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Atenas Gym · maqueta de su página web">
  <meta property="og:description" content="Disciplina que se convierte en resultados. Planes, horario y ubicación en Chapinero, Cali.">
  <meta property="og:image" content={new URL(url('img/og.jpg'), Astro.site).href}>
  <link rel="icon" href={url('img/logo.png')} type="image/png">
  <link rel="preload" href={url('fuentes/archivo.woff2')} as="font" type="font/woff2" crossorigin>
  <style set:html={`@font-face{font-family:'Archivo';src:url('${url('fuentes/archivo.woff2')}') format('woff2');font-weight:100 900;font-stretch:62% 125%;font-display:swap}`}></style>
</head>
<body>
  <p class="aviso">
    <strong>Maqueta de propuesta para Atenas Gym.</strong> No es su página oficial: precios y horario son los de su Instagram; las fotos son de referencia y los botones de WhatsApp le escriben a José David, quien la hizo.
  </p>

  <header class="barra">
    <a class="marca" href="#inicio" aria-label="Atenas Gym, inicio">Atenas <span>Gym</span></a>
    <nav class="menu" aria-label="Secciones">
      <a href="#planes">Planes</a>
      <a href="#horario">Horario</a>
      <a href="#sala">La sala</a>
      <a href="#ubicacion">Ubicación</a>
      <a href="#sistema">App de socios</a>
    </nav>
    <a class="boton boton--naranja boton--chico" href={wa('Hola Atenas Gym, quiero información de los planes.')} target="_blank" rel="noopener">Inscribirme</a>
  </header>

  <main id="inicio">
    <section class="portada" style={`--foto: url('${url('img/gym-oscuro.webp')}')`}>
      <div class="portada__contenido">
        <p class="estado" data-estado aria-live="polite">Horario de hoy</p>
        <h1 class="titular">
          <span class="titular__linea">Disciplina</span>
          <span class="titular__linea titular__chica">que se convierte en</span>
          <span class="titular__linea titular__naranja">resultados</span>
        </h1>
        <p class="portada__lema">Entrena. Evoluciona. Supérate.</p>
        <div class="acciones">
          <a class="boton boton--naranja" href="#planes">Ver planes desde $13.000</a>
          <a class="boton boton--vidrio" href={wa('Hola Atenas Gym, quiero ir a conocer el gimnasio. ¿A qué hora puedo pasar?')} target="_blank" rel="noopener">Agendar visita</a>
        </div>
      </div>
      <ul class="datos">
        {DATOS.map((d) => <li><strong>{d.valor}</strong><span>{d.texto}</span></li>)}
      </ul>
    </section>

    <div class="cinta" aria-hidden="true">
      <div class="cinta__pista">
        {[0, 1].map(() => <span>Entrena ✦ Evoluciona ✦ Supérate ✦ Chapinero ✦ 1.400 m² ✦ Entrena ✦ Evoluciona ✦ Supérate ✦ Chapinero ✦ 1.400 m² ✦ </span>)}
      </div>
    </div>

    <section class="seccion" id="planes" aria-labelledby="t-planes">
      <header class="cabeza revelar">
        <p class="antetitulo">Tarifas 2026</p>
        <h2 id="t-planes">Elija su plan</h2>
        <p>Toque «Lo quiero» y le llega a recepción por WhatsApp con el plan ya escrito.</p>
      </header>

      <div class="pestanas" role="tablist" aria-label="Tipo de plan" data-pestanas>
        {GRUPOS.map((g) => (
          <button role="tab" type="button" id={`tab-${g.id}`} aria-controls={`panel-${g.id}`} aria-selected={g.id === 'mes' ? 'true' : 'false'} data-tab={g.id}>{g.titulo}</button>
        ))}
      </div>

      {GRUPOS.map((g) => (
        <div class="planes" role="tabpanel" id={`panel-${g.id}`} aria-labelledby={`tab-${g.id}`} data-panel={g.id}>
          {PLANES.filter((p) => p.grupo === g.id).map((p) => (
            <article class:list={['plan', 'revelar', { 'plan--destacado': p.destacado }]}>
              {p.destacado && <p class="plan__sello">{g.id === 'largo' ? 'Mejor precio' : 'El más elegido'}</p>}
              <h3>{p.nombre}</h3>
              <p class="plan__precio">{pesos(p.precio)}{p.sufijo && <small> {p.sufijo}</small>}</p>
              {p.meses > 1 ? (
                <p class="plan__detalle">
                  Sale a <strong>{pesos(p.precio / p.meses)}</strong> al mes.<br>
                  Ahorra {pesos(ahorro(p))} frente a pagar mes a mes.
                </p>
              ) : (
                <p class="plan__detalle">{p.detalle}</p>
              )}
              <a class="boton boton--linea" href={wa(`Hola Atenas Gym, quiero el plan ${p.nombre} (${pesos(p.precio)}${p.sufijo ? ' c/u' : ''}).`)} target="_blank" rel="noopener">Lo quiero</a>
            </article>
          ))}
        </div>
      ))}

      <aside class="personalizado revelar">
        <div>
          <p class="antetitulo">Acompañamiento durante tu proceso</p>
          <h3>Entrenamiento personalizado</h3>
          <p>Un entrenador para usted, con un plan según su objetivo: bajar de peso, ganar masa muscular o volver a entrenar después de un tiempo.</p>
        </div>
        <a class="boton boton--naranja" href={wa('Hola Atenas Gym, quiero información del entrenamiento personalizado.')} target="_blank" rel="noopener">Preguntar por personalizado</a>
      </aside>
    </section>

    <section class="seccion seccion--clara" id="horario" aria-labelledby="t-horario">
      <header class="cabeza revelar">
        <p class="antetitulo">Abiertos 7 días</p>
        <h2 id="t-horario">Horario</h2>
        <p data-estado-texto>Venga a la hora que le quede: entre semana, de 5 de la mañana a 11 de la noche.</p>
      </header>
      <ul class="horario">
        {HORARIO.map((h) => (
          <li class="horario__dia revelar" data-dias={h.data}>
            <span class="horario__nombre">{h.dias}</span>
            <span class="horario__horas">{h.horas}</span>
            <span class="horario__hoy">Hoy</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="seccion" id="sala" aria-labelledby="t-sala">
      <header class="cabeza revelar">
        <p class="antetitulo">1.400 m² · máquinas importadas</p>
        <h2 id="t-sala">La sala</h2>
        <p>Fotos de referencia: en la página van las de la sala de Atenas.</p>
      </header>
      <div class="galeria">
        {FOTOS.map(([foto, texto, forma]) => (
          <figure class:list={['galeria__foto', 'revelar', { 'galeria__foto--alta': forma === 'alta' }]}>
            <img src={url(`img/${foto}`)} alt={texto} loading="lazy">
            <figcaption>{texto}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="seccion seccion--clara" id="ubicacion" aria-labelledby="t-ubicacion">
      <div class="ubicacion">
        <div class="revelar">
          <p class="antetitulo">Barrio Chapinero</p>
          <h2 id="t-ubicacion">Cómo llegar</h2>
          <p class="ubicacion__direccion">{GIMNASIO.direccion}</p>
          <p>Parqueadero privado para quienes entrenan.</p>
          <div class="acciones">
            <a class="boton boton--oscuro" href={mapa} target="_blank" rel="noopener">Abrir en Google Maps</a>
            <a class="boton boton--linea-oscura" href={`https://waze.com/ul?q=${encodeURIComponent(GIMNASIO.direccion)}`} target="_blank" rel="noopener">Abrir en Waze</a>
          </div>
        </div>
        <iframe class="mapa revelar" title="Mapa de Atenas Gym" src={`${mapa}&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </section>

    <section class="seccion sistema" id="sistema" aria-labelledby="t-sistema">
      <div class="sistema__texto revelar">
        <p class="antetitulo">Parte de la propuesta · Para el gimnasio</p>
        <h2 id="t-sistema">Su gimnasio, también en el celular de cada socio</h2>
        <p>La página se conecta con un sistema hecho para gimnasios de barrio en Colombia:</p>
        <ul class="sistema__lista">
          <li><strong>Entrada con QR</strong> que cambia cada minuto: nadie entra con el plan vencido ni presta su carné.</li>
          <li><strong>Quién debe y quién se vence:</strong> abonos, saldos y «vencen esta semana», con un botón para avisarle por WhatsApp.</li>
          <li><strong>Caja por turno:</strong> efectivo, Nequi, Daviplata y Bre-B, y los pagos no se borran: se anulan con motivo.</li>
          <li><strong>App del socio:</strong> sus días, su rutina con fotos, sus cargas y sus medidas, sin preguntarle a recepción.</li>
          <li><strong>Sin empezar de cero:</strong> se cargan sus socios desde el Excel que ya tienen.</li>
        </ul>
        <a class="boton boton--naranja" href={`https://wa.me/${WHATSAPP}?text=${encodeURIComponent('Hola José David, vi la maqueta de Atenas Gym y quiero ver el sistema para el gimnasio.')}`} target="_blank" rel="noopener">Quiero verlo funcionando</a>
      </div>

      <div class="sistema__visual revelar" aria-label="Ejemplo de la app del socio y del panel del gimnasio">
        <div class="celular">
          <div class="celular__pantalla">
            <p class="app__saludo">Hola, Laura 👋</p>
            <div class="app__plan">
              <span>Plan 1 mes</span>
              <strong>18 días</strong>
              <span>le quedan · vence el 29-nov</span>
              <div class="app__barra"><i style="width: 40%"></i></div>
            </div>
            <div class="app__qr">
              <svg viewBox={`-1 -1 ${QR + 2} ${QR + 2}`} role="img" aria-label="Código QR de ejemplo">
                <rect x="-1" y="-1" width={QR + 2} height={QR + 2} fill="white" />
                {celdas.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="#1a1714" />)}
              </svg>
              <span>Muéstrelo en la entrada · cambia en <b data-cuenta>60</b> s</span>
            </div>
            <div class="app__rutina">
              <span>Hoy toca</span>
              <strong>Pierna y glúteo · 6 ejercicios</strong>
            </div>
          </div>
        </div>
        <div class="panel">
          <p class="panel__titulo">Panel de Atenas Gym · hoy</p>
          <ul>
            {PANEL.map((d) => <li><strong>{d.valor}</strong><span>{d.texto}</span></li>)}
          </ul>
          <p class="panel__nota">Datos de ejemplo</p>
        </div>
      </div>
    </section>

    <section class="final">
      <h2>El primer paso es venir.</h2>
      <p>Escríbanos y le contamos qué plan le sirve.</p>
      <a class="boton boton--oscuro" href={wa('Hola Atenas Gym, estoy listo(a) para dar el primer paso. Quiero información sobre los planes.')} target="_blank" rel="noopener">Escribir por WhatsApp</a>
    </section>
  </main>

  <footer class="pie">
    <div>
      <p class="marca">Atenas <span>Gym</span></p>
      <p>{GIMNASIO.direccion} · WhatsApp {GIMNASIO.telefono}</p>
      <p><a href={GIMNASIO.instagram} target="_blank" rel="noopener">Instagram</a> · <a href={GIMNASIO.facebook} target="_blank" rel="noopener">Facebook</a> · @atenasgymcali</p>
    </div>
    <div class="pie__autor">
      <p>Maqueta de propuesta hecha por <strong>José David Rodríguez Pinilla</strong>, desarrollador web en Cali.</p>
      <a href="https://josed235.github.io" target="_blank" rel="noopener">Ver portafolio</a>
    </div>
  </footer>

  <a class="flotante" href={wa('Hola Atenas Gym, quiero información de los planes.')} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
  </a>

  <script>
    import { estado, enBogota } from '../lib/horario.js';

    // "Abierto ahora" y el día de hoy en el horario, en hora de Colombia. Se recalcula cada minuto.
    const aviso = document.querySelector('[data-estado]');
    function pintarEstado() {
      const ahora = new Date();
      const { abierto, texto } = estado(ahora);
      aviso.textContent = texto;
      aviso.classList.toggle('estado--abierto', abierto);
      const { dia } = enBogota(ahora);
      for (const li of document.querySelectorAll('[data-dias]')) {
        li.classList.toggle('es-hoy', li.dataset.dias.split(',').includes(String(dia)));
      }
    }
    pintarEstado();
    setInterval(pintarEstado, 60_000);

    // Cuenta regresiva del QR de muestra, para que se entienda que cambia cada minuto.
    const cuenta = document.querySelector('[data-cuenta]');
    let segundos = 60;
    setInterval(() => { segundos = segundos === 1 ? 60 : segundos - 1; cuenta.textContent = String(segundos); }, 1000);

    // Pestañas de planes. Sin JS se ven todos los grupos.
    const pestanas = document.querySelectorAll('[data-tab]');
    function mostrar(id) {
      for (const b of pestanas) b.setAttribute('aria-selected', String(b.dataset.tab === id));
      for (const p of document.querySelectorAll('[data-panel]')) p.hidden = p.dataset.panel !== id;
    }
    for (const b of pestanas) b.addEventListener('click', () => mostrar(b.dataset.tab));
    mostrar('mes');

    // Entrada suave de los bloques al hacer scroll (se omite si el usuario pidió menos movimiento).
    const bloques = document.querySelectorAll('.revelar');
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('con-movimiento');
      const io = new IntersectionObserver((entradas) => {
        for (const e of entradas) if (e.isIntersecting) { e.target.classList.add('visto'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      bloques.forEach((b) => io.observe(b));
    }
  </script>

  <style is:global>
    :root {
      --fondo: #141210;
      --fondo-2: #1d1a17;
      --fondo-3: #2a2622;
      --crema: #f6f1ea;
      --crema-2: #ece4d8;
      --texto: #f4efe8;
      --texto-2: #b9b0a5;
      --tinta: #1a1714;
      --naranja: #ff7a1a;
      --naranja-2: #ff9a4d;
      --verde: #3ddc84;
      --fuente: 'Archivo', 'Arial Narrow', system-ui, sans-serif;
      --ancho: 72rem;
      --curva: cubic-bezier(0.2, 0.9, 0.25, 1);
      color-scheme: dark;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 5rem; }
    body { margin: 0; background: var(--fondo); color: var(--texto); font-family: var(--fuente); font-size: 1.05rem; line-height: 1.55; -webkit-font-smoothing: antialiased; }
    img { display: block; max-width: 100%; }
    a { color: inherit; }
    h1, h2, h3 { margin: 0; line-height: 0.95; font-weight: 900; text-transform: uppercase; font-stretch: 75%; }
    :focus-visible { outline: 3px solid var(--naranja); outline-offset: 3px; }

    .aviso { margin: 0; padding: 0.6rem 1rem; background: var(--crema); color: var(--tinta); font-size: 0.85rem; text-align: center; }

    /* Barra */
    .barra { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 1.5rem; padding: 0.9rem clamp(1rem, 4vw, 3rem); background: color-mix(in oklab, var(--fondo) 85%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--fondo-3); }
    .marca { font-weight: 900; font-stretch: 125%; font-size: 1.35rem; text-transform: uppercase; letter-spacing: 0.02em; text-decoration: none; white-space: nowrap; margin: 0; }
    .marca span { color: var(--naranja); }
    .menu { display: flex; gap: 1.5rem; margin-left: auto; }
    .menu a { text-decoration: none; text-transform: uppercase; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.08em; color: var(--texto-2); transition: color 0.2s; }
    .menu a:hover { color: var(--naranja); }
    @media (max-width: 52rem) { .menu { display: none; } .barra .boton { margin-left: auto; } }

    /* Botones */
    .boton { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.95rem 1.6rem; border-radius: 999px; border: 2px solid transparent; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.85rem; text-decoration: none; cursor: pointer; transition: transform 0.25s var(--curva), background-color 0.2s, box-shadow 0.25s; }
    .boton:hover { transform: translateY(-2px); }
    .boton--chico { padding: 0.6rem 1.1rem; font-size: 0.75rem; }
    .boton--naranja { background: var(--naranja); color: var(--tinta); box-shadow: 0 10px 30px -10px color-mix(in oklab, var(--naranja) 70%, transparent); }
    .boton--naranja:hover { background: var(--naranja-2); }
    .boton--vidrio { background: color-mix(in oklab, white 10%, transparent); border-color: color-mix(in oklab, white 35%, transparent); color: var(--texto); backdrop-filter: blur(6px); }
    .boton--linea { border-color: var(--fondo-3); color: var(--texto); width: 100%; }
    .boton--linea:hover { border-color: var(--naranja); color: var(--naranja); }
    .boton--oscuro { background: var(--tinta); color: var(--crema); }
    .boton--linea-oscura { border-color: var(--tinta); color: var(--tinta); }

    /* Portada */
    .portada { position: relative; min-height: min(92svh, 56rem); display: grid; align-content: end; padding: 7rem clamp(1rem, 5vw, 4rem) 2rem; background: linear-gradient(180deg, rgb(20 18 16 / 0.35) 0%, rgb(20 18 16 / 0.6) 45%, var(--fondo) 100%), linear-gradient(90deg, rgb(20 18 16 / 0.85), transparent 70%), var(--foto) center / cover; overflow: hidden; }
    .portada__contenido { max-width: var(--ancho); width: 100%; margin: 0 auto; }
    .estado { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0 0 1.25rem; padding: 0.4rem 0.9rem; border-radius: 999px; background: rgb(0 0 0 / 0.45); border: 1px solid var(--fondo-3); font-size: 0.85rem; color: var(--texto-2); }
    .estado::before { content: ''; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--texto-2); }
    .estado--abierto { color: var(--verde); }
    .estado--abierto::before { background: var(--verde); box-shadow: 0 0 0 0 var(--verde); animation: latido 2s infinite; }
    @keyframes latido { 70% { box-shadow: 0 0 0 0.5rem transparent; } }
    .titular { font-size: clamp(3.4rem, 12vw, 9.5rem); letter-spacing: -0.01em; }
    .titular__linea { display: block; }
    .titular__chica { font-size: 0.32em; font-stretch: 100%; letter-spacing: 0.12em; color: var(--texto-2); margin: 0.4em 0 0.25em; }
    .titular__naranja { color: transparent; -webkit-text-stroke: 2px var(--naranja); }
    @supports (background-clip: text) {
      .titular__naranja { background: linear-gradient(90deg, var(--naranja), #ffb070); -webkit-background-clip: text; background-clip: text; -webkit-text-stroke: 0; }
    }
    .portada__lema { margin: 1.25rem 0 2rem; font-size: clamp(1.1rem, 2.4vw, 1.5rem); font-weight: 600; letter-spacing: 0.04em; }
    .acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .datos { list-style: none; max-width: var(--ancho); width: 100%; margin: 4rem auto 0; padding: 1.5rem 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; border-top: 1px solid var(--fondo-3); }
    .datos li { display: grid; }
    .datos strong { font-size: clamp(1.4rem, 3vw, 2.2rem); font-weight: 900; font-stretch: 80%; text-transform: uppercase; color: var(--naranja); line-height: 1.1; }
    .datos span { color: var(--texto-2); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; }
    @media (max-width: 40rem) { .datos { grid-template-columns: repeat(2, 1fr); row-gap: 1.25rem; } .datos strong { font-size: 1.3rem; } }

    /* Cinta naranja con borde de papel rasgado, como sus piezas de Instagram */
    .cinta { background: var(--naranja); color: var(--tinta); overflow: hidden; padding: 1.1rem 0; clip-path: polygon(0 12%, 4% 0, 9% 10%, 15% 2%, 22% 12%, 30% 1%, 37% 10%, 45% 0, 52% 11%, 60% 2%, 67% 12%, 75% 0, 82% 10%, 90% 1%, 96% 11%, 100% 3%, 100% 90%, 95% 100%, 88% 89%, 80% 99%, 72% 88%, 64% 100%, 57% 90%, 49% 99%, 41% 88%, 33% 100%, 25% 89%, 17% 99%, 9% 88%, 3% 98%, 0 90%); }
    .cinta__pista { display: flex; width: max-content; animation: desliza 40s linear infinite; }
    .cinta span { font-weight: 900; font-stretch: 75%; text-transform: uppercase; font-size: clamp(1.4rem, 3vw, 2.2rem); white-space: nowrap; padding-right: 1rem; }
    @keyframes desliza { to { transform: translateX(-50%); } }

    /* Secciones */
    .seccion { padding: clamp(4rem, 9vw, 7rem) clamp(1rem, 5vw, 4rem); max-width: calc(var(--ancho) + 8rem); margin: 0 auto; }
    .seccion--clara { max-width: none; background: var(--crema); color: var(--tinta); }
    .seccion--clara > * { max-width: var(--ancho); margin-left: auto; margin-right: auto; }
    .cabeza { max-width: 40rem; margin-bottom: 2.5rem; }
    .cabeza h2 { font-size: clamp(2.6rem, 7vw, 5rem); }
    .cabeza p:last-child { color: var(--texto-2); margin: 1rem 0 0; }
    .seccion--clara .cabeza p:last-child { color: #5d554c; }
    .antetitulo { margin: 0 0 0.6rem; color: var(--naranja); font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.8rem; }
    .seccion--clara .antetitulo { color: #c4520a; }

    /* Planes */
    .pestanas { display: inline-flex; gap: 0.25rem; padding: 0.3rem; margin-bottom: 2rem; border-radius: 999px; background: var(--fondo-2); border: 1px solid var(--fondo-3); max-width: 100%; overflow-x: auto; }
    .pestanas button { font: inherit; font-weight: 800; font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.7rem 1.2rem; border: 0; border-radius: 999px; background: transparent; color: var(--texto-2); cursor: pointer; white-space: nowrap; transition: background-color 0.2s, color 0.2s; }
    .pestanas button[aria-selected='true'] { background: var(--naranja); color: var(--tinta); }
    @media (max-width: 40rem) { .pestanas { display: flex; width: 100%; } .pestanas button { flex: 1; padding: 0.7rem 0.4rem; font-size: 0.7rem; letter-spacing: 0.02em; } }
    .planes { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; }
    .planes[hidden] { display: none; }
    .plan { position: relative; display: flex; flex-direction: column; gap: 0.6rem; padding: 1.75rem 1.5rem 1.5rem; border-radius: 1.25rem; background: var(--fondo-2); border: 1px solid var(--fondo-3); transition: transform 0.3s var(--curva), border-color 0.3s; }
    .plan:hover { transform: translateY(-4px); border-color: color-mix(in oklab, var(--naranja) 50%, var(--fondo-3)); }
    .plan h3 { font-size: 1.6rem; }
    .plan__precio { margin: 0; font-size: 2.6rem; font-weight: 900; font-stretch: 80%; line-height: 1; }
    .plan__precio small { font-size: 0.9rem; color: var(--texto-2); }
    .plan__detalle { margin: 0 0 0.75rem; color: var(--texto-2); font-size: 0.95rem; flex: 1; }
    .plan__detalle strong { color: var(--texto); }
    .plan--destacado { background: linear-gradient(160deg, #2b1a0c, var(--fondo-2) 60%); border-color: var(--naranja); }
    .plan--destacado .plan__precio { color: var(--naranja); }
    .plan--destacado .boton--linea { background: var(--naranja); border-color: var(--naranja); color: var(--tinta); }
    .plan__sello { position: absolute; top: -0.75rem; left: 1.25rem; margin: 0; padding: 0.25rem 0.75rem; border-radius: 999px; background: var(--naranja); color: var(--tinta); font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; }
    .personalizado { margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: 1.5rem; background: radial-gradient(circle at 100% 0%, color-mix(in oklab, var(--naranja) 30%, transparent), transparent 60%), var(--fondo-2); border: 1px solid var(--fondo-3); }
    .personalizado h3 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
    .personalizado p:last-child { max-width: 36rem; color: var(--texto-2); margin: 0.75rem 0 0; }

    /* Horario */
    .horario { list-style: none; margin: 0 auto; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; }
    .horario__dia { position: relative; display: grid; gap: 0.35rem; padding: 1.5rem; border-radius: 1.25rem; background: white; border: 1px solid var(--crema-2); }
    .horario__nombre { font-weight: 900; font-stretch: 75%; text-transform: uppercase; font-size: 1.6rem; line-height: 1; }
    .horario__horas { color: #5d554c; font-weight: 600; }
    .horario__hoy { display: none; position: absolute; top: 1rem; right: 1rem; padding: 0.2rem 0.6rem; border-radius: 999px; background: var(--naranja); color: var(--tinta); font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; }
    .horario__dia.es-hoy { background: var(--tinta); color: var(--crema); border-color: var(--tinta); }
    .horario__dia.es-hoy .horario__horas { color: var(--naranja-2); }
    .horario__dia.es-hoy .horario__hoy { display: block; }

    /* Galería */
    .galeria { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 15rem; gap: 1rem; }
    .galeria__foto { position: relative; margin: 0; overflow: hidden; border-radius: 1.25rem; }
    .galeria__foto--alta { grid-row: span 2; }
    .galeria__foto img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--curva); }
    .galeria__foto:hover img { transform: scale(1.06); }
    .galeria__foto figcaption { position: absolute; left: 0.9rem; bottom: 0.9rem; padding: 0.3rem 0.8rem; border-radius: 999px; background: rgb(0 0 0 / 0.6); backdrop-filter: blur(6px); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
    @media (max-width: 40rem) { .galeria { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 11rem; } }

    /* Ubicación */
    .ubicacion { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
    .ubicacion h2 { font-size: clamp(2.6rem, 7vw, 5rem); }
    .ubicacion__direccion { font-size: 1.4rem; font-weight: 800; margin: 1.25rem 0 0.25rem; }
    .ubicacion .acciones { margin-top: 1.5rem; }
    .mapa { width: 100%; aspect-ratio: 4 / 3; border: 0; border-radius: 1.5rem; filter: grayscale(0.3) contrast(1.05); }
    @media (max-width: 52rem) { .ubicacion { grid-template-columns: 1fr; } }

    /* Sistema para el gimnasio (gym-app) */
    .sistema { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
    .sistema h2 { font-size: clamp(2.2rem, 5vw, 3.8rem); }
    .sistema__texto > p:not(.antetitulo) { color: var(--texto-2); margin: 1.25rem 0 1rem; }
    .sistema__lista { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: 0.9rem; }
    .sistema__lista li { position: relative; padding-left: 1.75rem; color: var(--texto-2); }
    .sistema__lista li::before { content: ''; position: absolute; left: 0; top: 0.45rem; width: 0.7rem; height: 0.7rem; border-radius: 3px; background: var(--naranja); transform: rotate(45deg); }
    .sistema__lista strong { color: var(--texto); }
    .sistema__visual { position: relative; display: grid; justify-items: center; padding: 2rem 0; }
    .sistema__visual::before { content: ''; position: absolute; inset: 10% 5%; border-radius: 50%; background: radial-gradient(circle, color-mix(in oklab, var(--naranja) 35%, transparent), transparent 65%); filter: blur(30px); }
    .celular { position: relative; width: 17rem; padding: 0.7rem; border-radius: 2.6rem; background: #0b0a09; border: 1px solid #3a352f; box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.8); transform: rotate(-3deg); }
    .celular__pantalla { display: grid; gap: 0.75rem; padding: 1.5rem 1rem 1.25rem; border-radius: 2rem; background: var(--fondo-2); }
    .app__saludo { margin: 0; font-weight: 700; }
    .app__plan { display: grid; padding: 1rem; border-radius: 1rem; background: linear-gradient(140deg, var(--naranja), #ff5e00); color: var(--tinta); font-size: 0.8rem; }
    .app__plan strong { font-size: 2.4rem; font-weight: 900; font-stretch: 80%; line-height: 1; margin: 0.2rem 0; }
    .app__barra { height: 0.35rem; margin-top: 0.6rem; border-radius: 999px; background: rgb(0 0 0 / 0.2); overflow: hidden; }
    .app__barra i { display: block; height: 100%; background: var(--tinta); }
    .app__qr { display: grid; justify-items: center; gap: 0.5rem; padding: 1rem; border-radius: 1rem; background: white; color: #5d554c; font-size: 0.72rem; text-align: center; }
    .app__qr svg { width: 9rem; height: 9rem; shape-rendering: crispEdges; }
    .app__qr b { color: #c4520a; }
    .app__rutina { display: grid; padding: 0.8rem 1rem; border-radius: 1rem; background: var(--fondo-3); font-size: 0.8rem; color: var(--texto-2); }
    .app__rutina strong { color: var(--texto); font-size: 0.95rem; }
    .panel { position: absolute; right: 0; bottom: 0; width: 15rem; padding: 1rem 1.1rem; border-radius: 1.1rem; background: var(--crema); color: var(--tinta); box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.8); transform: rotate(2deg); }
    .panel__titulo { margin: 0 0 0.6rem; font-weight: 800; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; }
    .panel ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
    .panel li { display: grid; }
    .panel li strong { font-size: 1.25rem; font-weight: 900; font-stretch: 80%; line-height: 1.1; }
    .panel li span { font-size: 0.7rem; color: #5d554c; }
    .panel__nota { margin: 0.6rem 0 0; font-size: 0.65rem; color: #8a8178; }
    @media (max-width: 52rem) {
      .sistema { grid-template-columns: 1fr; }
      .panel { position: relative; margin-top: -2rem; transform: rotate(1deg); }
    }

    /* Cierre */
    .final { text-align: center; padding: clamp(4rem, 10vw, 7rem) 1rem; background: var(--naranja); color: var(--tinta); }
    .final h2 { font-size: clamp(2.6rem, 8vw, 5.5rem); }
    .final p { font-size: 1.15rem; margin: 1rem 0 2rem; }
    .pie { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2rem; padding: 3rem clamp(1rem, 5vw, 4rem) 6rem; color: var(--texto-2); font-size: 0.9rem; }
    .pie .marca { color: var(--texto); margin-bottom: 0.5rem; }
    .pie p { margin: 0.25rem 0; }
    .pie__autor { max-width: 24rem; }

    .flotante { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 30; display: grid; place-items: center; width: 3.6rem; height: 3.6rem; border-radius: 50%; background: #25d366; color: white; box-shadow: 0 10px 30px -8px rgb(0 0 0 / 0.6); transition: transform 0.25s var(--curva); }
    .flotante:hover { transform: scale(1.08); }
    .flotante svg { width: 1.9rem; height: 1.9rem; }

    /* Entrada al hacer scroll: solo si el script confirmó que el usuario acepta movimiento. */
    .con-movimiento .revelar { opacity: 0; transform: translateY(24px); transition: opacity 0.7s var(--curva), transform 0.7s var(--curva); }
    .con-movimiento .revelar.visto { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { .cinta__pista, .estado--abierto::before { animation: none; } html { scroll-behavior: auto; } }
  </style>
</body>
</html>
